# ---- App ----
NODE_ENV=development
APP_NAME=RIAL
APP_HOST=0.0.0.0
APP_PORT=8080
APP_VERSION=0.1.0
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SHUTDOWN_TIMEOUT_MS=15000

# ---- Auth ----
JWT_SECRET=dev-only-insecure-secret-change-me-please
JWT_ALG=HS256
JWT_ISSUER=rial-platform
JWT_AUDIENCE=rial-api
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
BCRYPT_ROUNDS=12
SESSION_COOKIE_NAME=rial_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
TOTP_ISSUER=RIAL
TOTP_WINDOW=1
FAILED_LOGIN_LIMIT=5

# ---- Settlement ----
SETTLEMENT_TOKEN_SYMBOL=RIAL
SETTLEMENT_TOKEN_NAME=﷼
EXCHANGE_RATE_STRATEGY=external
EXCHANGE_RATE_FIXED=
EXCHANGE_RATE_EXTERNAL_URL=
EXCHANGE_RATE_REFRESH_SEC=60
EXCHANGE_RATE_STALE_AFTER_SEC=300

# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rial
POSTGRES_USER=rial
POSTGRES_PASSWORD=rial
POSTGRES_SCHEMA=backend
POSTGRES_POOL_MIN=5
POSTGRES_POOL_MAX=50
POSTGRES_SSL=false
POSTGRES_STMT_TIMEOUT_MS=5000

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=rial:
REDIS_TLS=false

# ---- NATS ----
NATS_SERVERS=nats://localhost:4222
NATS_TOKEN=
NATS_USER=
NATS_PASS=
NATS_STREAM=rial-events
NATS_CONSUMER_PREFIX=rial-backend

# ---- Kafka ----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=rial-backend
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_AUDIT_TOPIC=rial.audit
KAFKA_CONSUMER_GROUP=rial-backend

# ---- Throttle ----
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ---- Telemetry ----
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=rial-backend
OTEL_DIAG=false
