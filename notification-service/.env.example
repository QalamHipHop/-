PORT=50056
NODE_ENV=development
LOG_LEVEL=info

# Optional: redis / nats / kafka
REDIS_URL=redis://redis:6379
NATS_URL=nats://nats:4222
KAFKA_BROKERS=kafka:9092

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@rial.local

# SMS
SMS_PROVIDER=noop

# Telegram / Discord
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# Web Push
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:admin@rial.local
