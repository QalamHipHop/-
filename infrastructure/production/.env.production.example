# Copy to an untracked .env.production and replace every value with a unique secret.
# Never commit .env.production, wallet seed phrases, private keys, or service-account exports.
NODE_ENV=production
POSTGRES_DB=rial
POSTGRES_USER=rial
POSTGRES_PASSWORD=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
CLICKHOUSE_DB=rial_analytics
CLICKHOUSE_USER=rial
CLICKHOUSE_PASSWORD=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
MINIO_ROOT_USER=rial-storage
MINIO_ROOT_PASSWORD=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
MEILI_MASTER_KEY=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
CSRF_SECRET=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
WALLET_INTERNAL_TOKEN=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
LAUNCHPAD_INTERNAL_TOKEN=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
GF_ADMIN_PASSWORD=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
API_BASE_URL=https://YOUR_PRODUCTION_DOMAIN
SOLANA_MAINNET_RPC_URL=https://YOUR_AUTHENTICATED_MAINNET_RPC
