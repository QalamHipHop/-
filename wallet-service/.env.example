RIAL_WALLET_APP_VERSION=0.1.0
RIAL_WALLET_ENV=development
RIAL_WALLET_HTTP_ADDR=:8081
RIAL_WALLET_GRPC_ADDR=:9091
RIAL_WALLET_OTEL_ENDPOINT=

RIAL_WALLET_POSTGRES_HOST=localhost
RIAL_WALLET_POSTGRES_PORT=5432
RIAL_WALLET_POSTGRES_DB=rial
RIAL_WALLET_POSTGRES_USER=rial
RIAL_WALLET_POSTGRES_PASSWORD=rial
RIAL_WALLET_POSTGRES_SCHEMA=wallet
RIAL_WALLET_POSTGRES_POOL_MAX=50
RIAL_WALLET_POSTGRES_SSL=false
RIAL_WALLET_POSTGRES_STMT_TIMEOUT_MS=5000

RIAL_WALLET_REDIS_ADDR=localhost:6379
RIAL_WALLET_REDIS_PASSWORD=
RIAL_WALLET_REDIS_DB=0
RIAL_WALLET_REDIS_PREFIX=rial:wallet:
RIAL_WALLET_REDIS_TLS=false

RIAL_WALLET_NATS_SERVERS=nats://localhost:4222
RIAL_WALLET_NATS_STREAM=rial-events
RIAL_WALLET_NATS_TOKEN=
RIAL_WALLET_NATS_USER=
RIAL_WALLET_NATS_PASS=

RIAL_WALLET_KAFKA_BROKERS=localhost:9092
RIAL_WALLET_KAFKA_AUDIT_TOPIC=rial.audit

RIAL_WALLET_CUSTODY_MODE=memory
RIAL_WALLET_CUSTODY_VAULT_ADDR=
RIAL_WALLET_CUSTODY_VAULT_TOKEN=
RIAL_WALLET_CUSTODY_AWS_REGION=
RIAL_WALLET_CUSTODY_AWS_KEY_ID=
RIAL_WALLET_CUSTODY_HOT_WALLET_LIMIT=1000000

RIAL_WALLET_SETTLEMENT_SYMBOL=RIAL
RIAL_WALLET_SETTLEMENT_DECIMALS=8
RIAL_WALLET_SETTLEMENT_RESERVE_ACCOUNT=reserve
RIAL_WALLET_SETTLEMENT_TREASURY_ACCOUNT=treasury
