# =========================================================================
#  ﷼ Platform — Environment Configuration (EXAMPLE)
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# =========================================================================

# ---- Core ----
NODE_ENV=development
APP_NAME=RIAL
APP_DOMAIN=localhost
APP_TIMEZONE=UTC
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# ---- Internal Settlement Token (﷼) ----
# Display name and ticker are both ﷼; backend treats as plain symbol.
SETTLEMENT_TOKEN_SYMBOL=RIAL
SETTLEMENT_TOKEN_NAME=﷼
# Exchange-rate strategy: fixed | floating | external
EXCHANGE_RATE_STRATEGY=external
# When fixed, value in USD per 1 ﷼
EXCHANGE_RATE_FIXED=
# When external, provider URL (e.g. central-bank feed) — must return JSON
EXCHANGE_RATE_EXTERNAL_URL=
EXCHANGE_RATE_REFRESH_SEC=60

# ---- Database ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rial
POSTGRES_USER=rial
POSTGRES_PASSWORD=change-me
POSTGRES_POOL_MIN=5
POSTGRES_POOL_MAX=50

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=rial_analytics
CLICKHOUSE_USER=rial
CLICKHOUSE_PASSWORD=change-me

ELASTICSEARCH_URL=http://elasticsearch:9200

MINIO_ROOT_USER=rial
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_PUBLIC=rial-public
MINIO_BUCKET_PRIVATE=rial-private

# ---- Streaming ----
NATS_URL=nats://nats:4222
KAFKA_BROKERS=kafka:9092

# ---- Auth ----
JWT_SECRET=change-me-with-32+-random-bytes
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
PASSEKEY_RP_NAME=RIAL
PASSKEY_RP_ID=localhost
SESSION_COOKIE_SECURE=false
TOTP_ISSUER=RIAL

# OAuth (optional)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_TELEGRAM_BOT_TOKEN=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=

# 2FA / SMS
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_FROM=RIAL

# ---- Wallets / Custody ----
# Internal wallet is on-platform; external is for user-controlled custody.
WALLET_INTERNAL_ENCRYPTION_KEY=32-byte-base64-key-here
HOT_WALLET_PROVIDER=local
HOT_WALLET_PUBLIC_KEY=
HOT_WALLET_PRIVATE_KEY=           # external-managed in prod
COLD_WALLET_PROVIDER=local
COLD_WALLET_PUBLIC_KEY=
COLD_WALLET_PRIVATE_KEY=
TREASURY_ADDRESS=
MULTISIG_THRESHOLD=3
MULTISIG_SIGNERS=                  # comma-separated addresses
HARDWARE_KEY_ENABLED=false

# ---- Chains ----
# EVM
# Development default: Ethereum Sepolia testnet. Replace with a private RPC for production.
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_CHAIN_ID=11155111
EVM_REGISTRY_ADDRESS=
EVM_ROUTER_ADDRESS=
EVM_FACTORY_ADDRESS=
EVM_PRIVATE_KEY=                   # relayer key, KMS-managed in prod

# Solana
# Development default: Solana Devnet. Devnet assets have no real-world value.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
SOLANA_PROGRAM_ID=
SOLANA_KEYPAIR=

# ---- Payment Adapters (pluggable) ----
# Any number of adapters can be enabled. Each adapter has its own creds.
# Development default: Stripe test mode only. Add live adapters only after production review.
PAYMENT_ADAPTERS=stripe
PAYMENT_DEFAULT_ADAPTER=stripe
PAYMENT_STRIPE_SECRET=
PAYMENT_STRIPE_WEBHOOK_SECRET=
PAYMENT_PARSIQ_API_KEY=
PAYMENT_CRYPTO_ONRAMP_API_KEY=
PAYMENT_WEBHOOK_PUBLIC_KEY=

# ---- Fees (default rates, all in basis points) ----
FEE_PLATFORM_BPS=50
FEE_CREATOR_BPS=30
FEE_REFERRAL_BPS=20
FEE_AFFILIATE_BPS=10
FEE_BURN_BPS=5
FEE_TREASURY_BPS=15
FEE_DYNAMIC_ENABLED=true

# ---- Bonding Curve Defaults ----
BONDING_CURVE_MODEL=sigmoid
BONDING_CURVE_GRADUATION_USD=69000
BONDING_CURVE_INITIAL_VIRTUAL=30
BONDING_CURVE_RESERVE=0

# ---- Trading ----
MATCHING_ENGINE_GRPC_URL=matching-engine:50051
TRADING_ENGINE_GRPC_URL=trading-engine:50052
MAX_ORDER_SIZE=1000000
MIN_ORDER_SIZE=1
ORDER_RATE_LIMIT_PER_MIN=300

# ---- Notifications ----
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
PUSH_PROVIDER=firebase
PUSH_FIREBASE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# ---- Security ----
RATE_LIMIT_GLOBAL_RPS=200
RATE_LIMIT_USER_RPS=20
DDOS_PROVIDER=cloudflare
CSRF_SECRET=change-me
ENCRYPTION_AT_REST=true
VAULT_ADDR=
VAULT_TOKEN=

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=30d

# ---- Backups ----
BACKUP_SCHEDULE=0 */6 * * *
BACKUP_S3_BUCKET=rial-backups
BACKUP_ENCRYPTION_KEY=32-byte-base64-key-here
BACKUP_RETENTION_DAYS=30
