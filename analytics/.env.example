NODE_ENV=development
ANALYTICS_PORT=3010
ANALYTICS_LOG_LEVEL=info

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=rial_analytics
CLICKHOUSE_USER=rial
CLICKHOUSE_PASSWORD=change-me

# Redis
REDIS_URL=redis://:change-me@localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=rial-analytics
KAFKA_GROUP_ID=rial-analytics-consumers

# NATS
NATS_URL=nats://localhost:4222

# Topics
KAFKA_TOPIC_TRADES=rial.trades.v1
KAFKA_TOPIC_LAUNCHES=rial.launches.v1
KAFKA_TOPIC_FEES=rial.fees.v1
KAFKA_TOPIC_AI_SIGNALS=rial.ai.signals.v1
