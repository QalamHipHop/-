# =============================================================================
#  RIAL payment-service — environment template
#  Copy to .env (root) or payment-service/.env
# =============================================================================

# ---- service ----
NODE_ENV=development
PAYMENT_HTTP_PORT=50055
PAYMENT_GRPC_PORT=50056
PAYMENT_LOG_LEVEL=info
PAYMENT_CORS_ORIGINS=*

# ---- database (optional, only if adapter persistence is enabled) ----
# PAYMENT_DATABASE_URL=postgres://rial:rial@postgres:5432/rial_payments

# ---- default adapter + currency ----
PAYMENT_DEFAULT_ADAPTER=manual
PAYMENT_DEFAULT_FIAT=USD

# ---- deposit / withdraw limits (minor units) ----
PAYMENT_MIN_DEPOSIT_MINOR=100
PAYMENT_MAX_DEPOSIT_MINOR=100000000000
PAYMENT_MIN_WITHDRAW_MINOR=1000
PAYMENT_MAX_WITHDRAW_MINOR=100000000000
PAYMENT_DAILY_WITHDRAW_LIMIT_MINOR=50000000000
PAYMENT_WITHDRAWAL_COOLDOWN_SECONDS=300

# ---- exchange rate provider (optional) ----
# PAYMENT_RATE_PROVIDER=openexchangerates
# PAYMENT_RATE_API_KEY=

# ---- adapter: stripe ----
STRIPE_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SANDBOX=true

# ---- adapter: zarinpal (Iranian fiat gateway) ----
ZARINPAL_ENABLED=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=

# ---- adapter: nowpayments (crypto) ----
NOWPAYMENTS_ENABLED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true

# ---- adapter: manual (always available) ----
MANUAL_PAYMENT_ENABLED=true
MANUAL_PAYMENT_INSTRUCTIONS="Contact treasury@rial.example for wire instructions"

# ---- shared secret for internal gRPC ----
PAYMENT_INTERNAL_TOKEN=change-me-internal-token
