# Copy to .env and fill in real values. NEVER commit .env.

# Deployer private key. Use a dedicated deployer account; never use a placeholder.
PRIVATE_KEY=REPLACE_WITH_NONZERO_64_HEX_PRIVATE_KEY

# Optional testnet deployment. The network is enabled only when both this URL and PRIVATE_KEY are set.
SEPOLIA_RPC_URL=https://YOUR_AUTHENTICATED_SEPOLIA_RPC

# Internal Rial/EVM target. Both variables are required for a real Rial deployment.
RIAL_RPC_URL=https://YOUR_AUTHENTICATED_RIAL_EVM_RPC
RIAL_CHAIN_ID=REPLACE_WITH_RIAL_CHAIN_ID

# Block explorer API
ETHERSCAN_API_KEY=

# Gas reporting
REPORT_GAS=false

# Initial platform config (used by deploy-all.ts)
INITIAL_OWNER=REPLACE_WITH_GOVERNANCE_OR_TIMELOCK_ADDRESS
GRADUATION_THRESHOLD_WAD=69000000000000000000000
PLATFORM_FEE_BPS=200
CREATOR_FEE_BPS=100
TREASURY_FEE_BPS=50
